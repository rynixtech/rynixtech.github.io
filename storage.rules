rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public read for website assets, admin-only write
    match /admin/images/{allPaths=**} {
      allow write: if isAdmin() 
                   && request.resource.size <= 10 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
    
    match /admin/videos/{allPaths=**} {
      allow write: if isAdmin() 
                   && request.resource.size <= 500 * 1024 * 1024 
                   && request.resource.contentType.matches('video/.*');
      allow read: if true;
    }
    
    match /admin/apks/{allPaths=**} {
      allow write: if isAdmin() 
                   && request.resource.size <= 200 * 1024 * 1024 
                   && request.resource.contentType.matches('application/vnd\\.android\\.package-archive');
      allow read: if true;
    }
    
    // Admin-only read/write for sensitive documents
    match /admin/documents/{allPaths=**} {
      allow write: if isAdmin() && request.resource.size <= 50 * 1024 * 1024;
      allow read: if isAdmin();
    }

    // Admin-only for audio files
    match /admin/audio/{allPaths=**} {
      allow write: if isAdmin()
                   && request.resource.size <= 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow read: if true;
    }

    // Catch-all: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
