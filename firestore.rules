rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('firebase-adminsdk-.*@rynixtech-e0281[.]iam[.]gserviceaccount[.]com')
      );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt']);
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && (!request.resource.data.keys().hasAll(['stock']) || request.resource.data.stock >= 0);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['items', 'amount', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /brainState/{docId} {
      allow read, write: if isAdmin();
    }

    match /brainEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /systemHealth/{healthId} {
      allow read, write: if isAdmin();
    }

    match /os_releases/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if isAdmin() || (resource.data.status == 'published' || resource.data.status == 'public');
      allow write: if isAdmin();
    }

    match /files/{fileId} {
      allow read, write: if isAdmin();
    }

    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /errors/{errorId} {
      allow create: if isAdmin();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /support/{supportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /admin_notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    match /system_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics_data/{docId} {
      allow read, write: if isAdmin();
    }

    match /shopping_store/{docId} {
      allow read, write: if isAdmin();
    }

    match /digital_products/{docId} {
      allow read, write: if isAdmin();
    }

    match /media_store/{docId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{docId} {
      allow read, write: if isAdmin();
    }

    match /inventory/{docId} {
      allow read, write: if isAdmin();
    }

    match /reviews/{docId} {
      allow read, write: if isAdmin();
    }

    match /admins/{docId} {
      allow read, write: if isAdmin();
    }

    match /customer_activity/{docId} {
      allow read, write: if isAdmin();
    }

    match /returns/{docId} {
      allow read, write: if isAdmin();
    }

    match /pages/{docId} {
      allow read, write: if isAdmin();
    }

    match /banners/{docId} {
      allow read, write: if isAdmin();
    }

    match /menus/{docId} {
      allow read, write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read, write: if isAdmin();
    }

    match /seo_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /app_versions/{docId} {
      allow read, write: if isAdmin();
    }

    match /downloads/{docId} {
      allow read, write: if isAdmin();
    }

    match /release_notes/{docId} {
      allow read, write: if isAdmin();
    }

    match /authors/{docId} {
      allow read, write: if isAdmin();
    }

    match /book_categories/{docId} {
      allow read, write: if isAdmin();
    }

    match /ebooks/{docId} {
      allow read, write: if isAdmin();
    }

    match /book_orders/{docId} {
      allow read, write: if isAdmin();
    }

    match /audio_media/{docId} {
      allow read, write: if isAdmin();
    }

    match /media_categories/{docId} {
      allow read, write: if isAdmin();
    }

    match /storage_stats/{docId} {
      allow read, write: if isAdmin();
    }

    match /security_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /store_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /payment_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /shipping_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /notifications_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /restore_points/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
