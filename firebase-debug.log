[debug] [2026-08-26T06:48:16.017Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/rynixtech-e0281/rulesets {"name":"projects/rynixtech-e0281/rulesets/a88ee9fc-2067-4edc-8939-49c70b860299","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAdmin() {\n      return request.auth != null && (\n        request.auth.token.admin == true ||\n        request.auth.token.email.matches('firebase-adminsdk-.*@rynixtech-e0281[.]iam[.]gserviceaccount[.]com')\n      );\n    }\n\n    match /users/{userId} {\n      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);\n      allow update: if request.auth != null \n                    && request.auth.uid == userId\n                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt']);\n      allow create: if request.auth != null \n                    && request.auth.uid == userId\n                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');\n      allow delete: if false;\n    }\n\n    match /products/{productId} {\n      allow read: if true;\n      allow write: if isAdmin() && (!request.resource.data.keys().hasAll(['stock']) || request.resource.data.stock >= 0);\n    }\n\n    match /orders/{orderId} {\n      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if isAdmin();\n    }\n\n    match /brainState/{docId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /brainEvents/{eventId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /systemHealth/{healthId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /os_releases/{releaseId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /books/{bookId} {\n      allow read: if isAdmin() || (resource.data.status == 'published' || resource.data.status == 'public');\n      allow write: if isAdmin();\n    }\n\n    match /files/{fileId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /apps/{appId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /websiteContent/{contentId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /activityLog/{logId} {\n      allow read, create: if isAdmin();\n      allow update, delete: if false;\n    }\n\n    match /errors/{errorId} {\n      allow create: if isAdmin();\n      allow read, update: if isAdmin();\n      allow delete: if false;\n    }\n\n    match /settings/{settingId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /support/{supportId} {\n      allow create: if true;\n      allow read, update, delete: if isAdmin();\n    }\n\n    match /admin_notifications/{notifId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /system_alerts/{alertId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /categories/{categoryId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-26T06:48:16.476783Z","metadata":{"services":["cloud.firestore"]}}
